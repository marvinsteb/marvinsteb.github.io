---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Marvin Esteban" description="Artículos sobre .NET, C#, SQL Server, automatización y desarrollo empresarial.">
  <Navbar currentPage="blog" />

  <div class="blog-index">
    <div class="container">
      <h1 class="blog-index-title">Blog</h1>
      <p class="blog-index-subtitle">Posts sobre desarrollo, tecnología y experiencias profesionales</p>

      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              url={`/blog/${post.id}/`}
            />
          ))}
        </div>
      ) : (
        <div style="text-align: center; padding: 80px 0;">
          <p style="color: var(--gray-light); font-size: 18px;">Próximamente nuevos posts. ¡Vuelve pronto!</p>
        </div>
      )}
    </div>
  </div>

  <footer class="footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Marvin Esteban. Todos los derechos reservados.</p>
    </div>
  </footer>
</Layout>
