---
import { linkedInData } from "../data/linkedin-data";

const { services } = linkedInData;
---

<section id="experience" class="experience-section">
  <div class="container">
    <div class="services-heading">
      <div>
        <p class="section-eyebrow">Cómo puedo ayudarte</p>
        <h2 class="section-title">Soluciones para que tu operación avance</h2>
      </div>
      <p class="services-intro">
        Integro SAP Business One con tus sistemas mediante DI API y Service Layer, automatizo
        tareas repetitivas y desarrollo herramientas adaptadas a tu operación.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service, index) => (
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-number">0{index + 1}</span>
            <i class:list={["fas", index === 0 ? "fa-code" : index === 1 ? "fa-gears" : "fa-plug"]}></i>
          </div>
          <h3>{service.title}</h3>
          <p class="service-summary">{service.company}</p>
          <span class="service-tech">{service.period}</span>
          <ul>
            {service.description.map((desc) => (
              <li>{desc}</li>
            ))}
          </ul>
          <a href="#contact" class="service-link">Conocer esta solución <span>→</span></a>
        </article>
      ))}
    </div>

    <div class="services-cta">
      <p>¿Tienes un proceso que podría funcionar mejor?</p>
      <a href="#contact" class="btn btn-primary">
        <i class="fas fa-comments"></i> Hablemos de tu proyecto
      </a>
    </div>
  </div>
</section>
