---
import { linkedInData } from "../data/linkedin-data";

const { profile } = linkedInData;
---

<section id="contact" class="contact-section">
  <div class="container">
    <h2 class="section-title">¿Tienes un reto? Hablemos</h2>
    <div class="contact-content">
      <div class="contact-info">
        <h3>Cuéntame qué necesitas</h3>
        <div class="info-items">
          <div class="info-item">
            <i class="fas fa-envelope"></i>
            <div>
              <h4>Email</h4>
              <p>{profile.email}</p>
            </div>
          </div>
          <div class="info-item">
            <i class="fas fa-phone"></i>
            <div>
              <h4>Teléfono</h4>
              <p>{profile.phone}</p>
            </div>
          </div>
          <div class="info-item">
            <i class="fas fa-map-marker-alt"></i>
            <div>
              <h4>Ubicación</h4>
              <p>{profile.location || "Ciudad, País"}</p>
            </div>
          </div>
        </div>

        <div class="social-links-footer">
          <a href="https://www.linkedin.com/in/marvinsteb/" target="_blank" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
          <a href="https://github.com/marvinsteb" target="_blank" aria-label="GitHub"><i class="fab fa-github"></i></a>
          <a href="https://www.facebook.com/marvinsteb/" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="https://twitter.com/marvin_steb" target="_blank" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
          <a href="https://www.instagram.com/marvin_steb/" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        </div>
      </div>

      <div class="contact-form">
        <form id="contact-form">
          <div class="form-group">
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Tu email" required />
          </div>
          <div class="form-group">
            <input type="text" name="asunto" placeholder="¿En qué puedo ayudarte?" required />
          </div>
          <div class="form-group">
            <textarea name="mensaje" rows="5" placeholder="Describe brevemente tu proyecto o problema" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-paper-plane"></i> Solicitar una conversación
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
